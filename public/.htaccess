# Diettissima — SPA en hosting Apache/LiteSpeed (Hostinger)
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # No reescribir ficheros o directorios existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Fallback SPA: cualquier ruta (/empezar, /informe/:token, ...) -> index.html
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # JS/CSS con hash en el nombre: cache inmutable 1 anyo
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Media sin hash: 7 dias
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
